{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@docsprout/shared": ["packages/shared/src/index.ts"],
      "@docsprout/core": ["packages/core/src/index.ts"],
      "@docsprout/themes": ["packages/themes/src/index.ts"]
    }
  }
}


